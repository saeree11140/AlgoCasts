{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist",
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["api/**/*.ts", "client/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
