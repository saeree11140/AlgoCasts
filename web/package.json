{
  "name": "algocasts-practice-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.12",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "content": "node scripts/prepare-content.mjs",
    "dev": "pnpm run content && vite --host 127.0.0.1",
    "build": "pnpm run content && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "pnpm run content && node --test tests/*.test.mjs",
    "check": "pnpm test && pnpm run build"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@fontsource/ibm-plex-sans-thai": "^5.3.0",
    "@lezer/highlight": "1.2.5",
    "codemirror": "^6.0.2",
    "dompurify": "^3.3.0",
    "marked": "^17.0.1",
    "sql.js": "^1.17.0",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/sql.js": "^1.16.0",
    "vite": "^7.2.2"
  }
}
